# FORMA local environment example (FOR-82, secret baseline FOR-90).
#
# compose.yaml already bakes in these same defaults, so a fresh checkout runs
# without an env file. Copy this to `.env` only to override them:
#   cp env.example .env
#
# These are LOCAL-ONLY fake values — never real secrets. `.env` is gitignored.
# Full variable reference and secret-handling rules: docs/configuration.md.
#
# Production note: set SPRING_PROFILES_ACTIVE=prod for real deployments. In that
# profile the backend REQUIRES SPRING_DATASOURCE_URL / _USERNAME / _PASSWORD from
# the environment and fails fast if any is missing (no unsafe fallback).

# --- PostgreSQL ---
POSTGRES_DB=forma
POSTGRES_USER=forma
POSTGRES_PASSWORD=forma_local_password
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=8080

# --- Withings integration (FOR-131) ---
# Empty here on purpose: the app boots and runs fine without them, and the
# connect action reports the missing variable by name instead of sending you to
# a Withings error page. Fill them in a real deployment with the values of the
# registered Withings application. Generate the encryption key once per
# environment: openssl rand -base64 32
#
# Setting them in `.env` is only half the job — every one of these is also
# listed under the backend service's `environment:` in compose.yaml, which is
# what actually passes them into the container.
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
WITHINGS_REDIRECT_URI=https://forma.diegobarrioh.dev/auth
WITHINGS_TOKEN_ENC_KEY=

# --- Plan agent (ADR-015 decision 10) ---
# Empty here on purpose: nothing in this slice calls PlanGenerationGateway#generate yet (slice 6
# wires the dispatcher), so an unconfigured value is simply inert rather than degraded. Fill in
# base-url/api-key once a real agent exists; timeout-seconds' default (120) is the ADR's own
# unmeasured-but-documented guess — see docs/configuration.md.
FORMA_PLAN_AGENT_BASE_URL=
FORMA_PLAN_AGENT_API_KEY=
FORMA_PLAN_AGENT_TIMEOUT_SECONDS=120

# --- Legacy placeholder account (FOR-145) ---
# Unset leaves the pre-auth data owner unusable, which is the safe default.
FORMA_BOOTSTRAP_LEGACY_USER_PASSWORD=

# --- Login with Google (ADR-012 addendum, ADR-014) ---
# Empty here on purpose: the app boots and every test/CI run passes without them
# (SecurityConfig only enables oauth2Login() when both are set); hitting
# /api/oauth2/authorization/google redirects to the login page with ?error=google
# instead. Register an OAuth client in Google Cloud Console with these authorized
# redirect URIs — one per origin the SPA is actually served from (the backend
# builds each from the request's X-Forwarded-Host, see vite.config.ts/nginx.conf):
#   https://forma.diegobarrioh.dev/api/login/oauth2/code/google   (prod — currently
#                                                                  under a preprod-
#                                                                  labeled domain,
#                                                                  see preproHost.ts)
#   http://localhost:3000/api/login/oauth2/code/google            (docker compose)
#   http://localhost:5173/api/login/oauth2/code/google            (npm run dev)
# http://localhost:8080/... (hitting the backend directly, bypassing every proxy)
# only works if FORMA_FRONTEND_URL is also set to an absolute origin — not a
# supported way to exercise Google login, so it is not registered by default.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where the backend sends the browser back to after a Google login (or a failed/
# unconfigured attempt, with ?error=google). Empty here too, on purpose: it then
# redirects to a same-origin RELATIVE path, which is already correct behind nginx
# (prod, and this compose setup — frontend/nginx.conf proxies /api/ to the backend
# on the same origin the browser reached) and behind Vite's dev proxy (plain
# `npm run dev`). Only set an absolute origin if you exercise Google login against
# this backend directly, bypassing every proxy — see docs/configuration.md.
FORMA_FRONTEND_URL=

# --- Frontend ---
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8080
