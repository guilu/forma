# Local environment overrides (never commit real secrets — see env.example).
.env
.env.local
.env.*.local

# OS
.DS_Store

# Editors
.vscode/
.idea/

# Agent tooling
.atl/

# Dependencies. Cada paquete tiene su propio .gitignore, pero la raíz también
# necesita el suyo: sin él se coló node_modules/.vite/vitest/…/results.json,
# la caché de resultados de vitest, versionada con fallos de hace meses dentro.
node_modules/

# Build output
backend/bin/

# Worktrees aislados que crean los agentes de IA: viven dentro del repo pero no
# son del repo. Sin esta línea aparecen como sin seguimiento y un `git add -A`
# despistado los commitearía enteros.
.claude/worktrees/
